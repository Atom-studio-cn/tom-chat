{
  "name": "tom-desktop",
  "version": "1.1.0",
  "description": "Tom desktop chat client",
  "main": "main.js",
  "author": "Tom",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "latest"
  },
  "build": {
    "appId": "com.tom.chat.desktop",
    "productName": "Tom",
    "copyright": "Copyright 2026 Tom",
    "icon": "build/icon.ico",
    "directories": {
      "output": "out-v13",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tom"
    }
  }
}
